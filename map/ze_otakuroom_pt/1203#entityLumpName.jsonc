                        "targetname": "!self",
                        "inputname": "Alpha",
                        "overrideparam": "255",
                        "delay": 0.0,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnUser1",
                        "targetname": "!self",
                        "inputname": "Open",
                        "delay": 0.1,
                        "timestofire": -1
                    },

                    {
                        "outputname": "OnUser1",
                        "targetname": "lv3_ex_boss*",
                        "inputname": "Kill",
                        "delay": 0.0,
                        "timestofire": -1
